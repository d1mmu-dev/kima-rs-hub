DATABASE_URL=postgres://kima:kima@localhost:5456/kima
KIMA_DATA_DIR=./.data
MUSIC_PATH=/path/to/your/music
LOG_LEVEL=debug
# Optional. Daily safety-net library reconcile, 5-field cron in UTC; `off` disables it.
#KIMA_LIBRARY_SYNC_CRON=0 4 * * *
# Optional. Cover-art cache cap in MB.
#KIMA_ARTWORK_CACHE_MB=512
# Optional. Where clients reach this server (http:// or https://). See docs/subsonic.md.
#KIMA_PUBLIC_URL=http://localhost:3030
