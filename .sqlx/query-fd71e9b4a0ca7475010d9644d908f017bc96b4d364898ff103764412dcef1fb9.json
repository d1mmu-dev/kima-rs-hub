{
  "db_name": "PostgreSQL",
  "query": "SELECT k.id AS key_id, k.profile_id,\n                  u.id, u.username, u.password_hash, u.role, u.onboarding_complete,\n                  u.token_version, u.created_at\n           FROM api_keys k\n           JOIN profiles pr ON pr.id = k.profile_id\n           JOIN users u ON u.id = pr.user_id\n           WHERE k.key_hash = $1",
