DATABASE_URL=postgres://kima:kima@localhost:5456/kima
KIMA_DATA_DIR=./.data
MUSIC_PATH=/path/to/your/music
LOG_LEVEL=debug
# Optional. Daily safety-net library reconcile, 5-field cron in UTC; `off` disables it.
#KIMA_LIBRARY_SYNC_CRON=0 4 * * *
# Optional. Cover-art cache cap in MB.
#KIMA_ARTWORK_CACHE_MB=512
# Optional. Where clients reach this server (http:// or https://). See docs/subsonic.md.
#KIMA_PUBLIC_URL=http://localhost:3030
# Optional. `off` turns off every outbound lookup (MusicBrainz, AcoustID, ...). Default `on`.
#KIMA_IDENTIFY=on
# Optional. Contact in the User-Agent of outbound requests.
#KIMA_CONTACT=https://github.com/d1mmu-dev/kima-rs-hub
# Optional. MusicBrainz or a local mirror.
#MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
# Optional. Keys used when none is saved in Settings > Artwork. Leave unset to enter them there.
#ACOUSTID_CLIENT_KEY=
#FANART_API_KEY=
# Optional. `true` turns off fingerprinting and AcoustID lookups.
#ACOUSTID_DISABLED=false
# Optional. Files fingerprinted at once (default: half the cores, at least 1).
#KIMA_FINGERPRINT_WORKERS=2
