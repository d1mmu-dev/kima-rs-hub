  "query": "SELECT t.title, ar.name AS artist, al.title AS album, t.duration_secs\n         FROM tracks t\n         JOIN albums al ON al.id = t.album_id\n         JOIN artists ar ON ar.id = al.artist_id\n         WHERE t.id = $1",
