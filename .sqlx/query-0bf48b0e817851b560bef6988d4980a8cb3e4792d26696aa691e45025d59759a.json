{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.track_id, p.played_at, p.heard, coalesce(t.display_title,t.title) AS \"title!\", coalesce(ar.display_name,ar.name) AS \"artist!\", t.duration_secs AS duration FROM plays p JOIN tracks t ON t.id=p.track_id JOIN albums al ON al.id=t.album_id JOIN artists ar ON ar.id=al.artist_id WHERE p.user_id=$1 ORDER BY p.played_at,p.id",
